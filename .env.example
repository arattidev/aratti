# App defaults
NODE_ENV=development
APP_ENV=development
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_DEFAULT_CURRENCY=ARS
AUTH_MODE=BYPASS
AUTH_TOKEN_SECRET=dev-only-auth-token-secret-change-me
PAYMENTS_MODE=MOCK
MEDIA_MODE=URL_ONLY

# API endpoints
API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Neon PostgreSQL
DATABASE_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require
DIRECT_URL=postgresql://<user>:<password>@<host>/<db>?sslmode=require

# Clerk auth
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=
CLERK_JWT_ISSUER=
CLERK_JWT_AUDIENCE=

# Mercado Pago (Argentina / LATAM)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# Apple Pay
APPLE_PAY_MERCHANT_ID=
APPLE_PAY_MERCHANT_DOMAIN=
APPLE_PAY_CERT_BASE64=
APPLE_PAY_KEY_BASE64=

# Stripe (future-ready)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Maps and geolocation
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Mobile public env
EXPO_PUBLIC_APP_NAME=Aratti
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=

# Push notifications
EXPO_PUSH_ACCESS_TOKEN=

# Security and rate limiting
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
SESSION_ENCRYPTION_KEY=
INTERNAL_WEBHOOK_SIGNING_SECRET=

# Observability and CI
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
VERCEL_PROJECT_ID=
VERCEL_ORG_ID=
