{
  "name": "aratti",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "format": "turbo format",
    "db:generate": "pnpm --filter @aratti/db db:generate",
    "db:migrate": "pnpm --filter @aratti/db db:migrate",
    "db:studio": "pnpm --filter @aratti/db db:studio"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}
